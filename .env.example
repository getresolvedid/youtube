# =============================================================================
# Konfigurasi channel — SATU sumber untuk semua secret & setelan produksi.
#
#   Salin berkas ini jadi .env, lalu isi nilainya:
#     Copy-Item .env.example .env
#
#   .env TIDAK PERNAH di-commit (lihat .gitignore). Berkas ini (.env.example)
#   yang di-commit — jadi setiap variabel baru WAJIB ditambahkan di sini juga,
#   dengan nilai kosong atau contoh, jangan nilai asli.
#
#   Cara memakai:
#     Node    : node --env-file=.env tools/skrip.mjs      (Node 22 native)
#     PowerShell: . .\tools\load-env.ps1                  (untuk sesi terminal)
#     Komposisi : lewat shared/config.gen.ts (npm run gen) — daftar putih saja
#
#   Dokumen: docs/08-konfigurasi.md
# =============================================================================


# --- Identitas channel -------------------------------------------------------
# Dipakai di end card, deskripsi video, dan metadata publish.

CHANNEL_NAME=
CHANNEL_HANDLE=
CHANNEL_URL=

# Tujuan CTA di akhir video. Kosongkan kalau belum diputuskan.
CTA_URL=https://getresolved.id
CTA_TEXT=


# Pagar panjang naskah: satu topik (1 video panjang + 2 Shorts) diperkirakan
# ~9.000-12.000 karakter. Naskah WAJIB beku sebelum VO dibuat - docs/04 §5.
VO_MAX_CHARS_PER_TOPIC=12000

# --- Gemini (voice over) -----------------------------------------------------
# Mesin TTS channel ini. API key: https://aistudio.google.com/apikey
# RAHASIA, jangan dibagikan, jangan pernah ditulis di luar berkas ini.
GEMINI_API_KEY=

# gemini-2.5-flash-preview-tts  paling murah, cukup untuk narasi
# gemini-2.5-pro-preview-tts    lebih patuh pada arahan gaya
# gemini-3.1-flash-tts-preview  paling baru
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ---- Empat setelan di bawah ini CADANGAN ------------------------------------
# Arahan pembacaan per topik hidup di ideas/<slug>/vo-gemini-profile.yaml —
# voice, profile, style, accent, pace, tempo, plus timpaan per keluaran (L/S1/S2).
# Nilai di bawah cuma dipakai untuk topik yang BELUM punya berkas profil itu.

# Salah satu dari 30 suara bawaan (Zephyr, Puck, Charon, Kore, Fenrir, Leda,
# Orus, Aoede, Algieba, Iapetus, Sadaltager, …). Daftar lengkapnya:
# https://ai.google.dev/gemini-api/docs/speech-generation
GEMINI_TTS_VOICE=Charon

# Gemini tidak punya stability/similarity — gaya diatur dengan kalimat biasa.
# Ia dipasang sebagai "<prompt>: <teks VO>", persis bentuk contoh resminya, dan
# TIDAK ikut disuarakan. Dipakai sebagai arahan UTUH, jadi tulis kalimat penuh.
# Diabaikan begitu topiknya punya vo-gemini-profile.yaml.
GEMINI_TTS_STYLE_PROMPT=Bacakan dalam bahasa Indonesia dengan tenang dan jelas, tempo sedang, seperti pencerita yang sedang menjelaskan

# Keluaran Gemini itu PCM mentah; ffmpeg mengubahnya jadi MP3 pada bitrate ini.
# ffmpeg-nya sendiri dicari lewat FFMPEG_PATH di kelompok Render di bawah.
GEMINI_TTS_MP3_BITRATE=128k

# Gemini menyisipkan senyap di awal & akhir tiap berkas (~0,39 dtk dan ~0,24 dtk).
# Yang depan merusak sinkron frame nol; yang belakang menggandakan VO_PAD_SECONDS
# yang sudah ditambahkan pipeline. Jeda di tengah kalimat tidak ikut dipangkas.
# Set "false" hanya untuk membandingkan dengan keluaran mentahnya.
GEMINI_TTS_TRIM_SILENCE=true

# Pengali tempo (ffmpeg atempo, nada dipertahankan). Gemini tidak punya
# parameter kecepatan numerik — di sana tempo diminta lewat kalimat, dan
# jawabannya berbeda 13% tiap generate. Angka ini yang tidak.
# 1.0 = apa adanya · >1 lebih cepat · <1 lebih lambat.
# Jangkauan 0.5–2.0; di luar 0.9–1.15 suaranya mulai terdengar diproses.
# Ini PENGALI, bukan target wpm: menyetel semua scene ke satu angka akan
# meratakan hook dan kalimat penjelasan, dan sebaran 115–167 wpm itu disengaja.
GEMINI_TTS_TEMPO=1.0


# --- Spesifikasi video -------------------------------------------------------
# Angka ini mengikat guideline docs/02. Mengubahnya = mengubah format channel.

VIDEO_FPS=30

LONG_WIDTH=1920
LONG_HEIGHT=1080
LONG_TARGET_SECONDS=480          # 8 menit

SHORT_WIDTH=1080
SHORT_HEIGHT=1920
SHORT_MAX_SECONDS=60

# Thumbnail — dirender dari komposisi Remotion, bukan digambar di luar, supaya
# palet dan tipografinya otomatis sekeluarga dengan videonya (docs/06).
#   16:9 untuk video panjang · 9:16 untuk kover Short.
# Keduanya angka yang disebut halaman bantuan YouTube sendiri.
THUMB_WIDTH=1280
THUMB_HEIGHT=720
THUMB_SHORT_WIDTH=2160
THUMB_SHORT_HEIGHT=3840

# Durasi scene standar — brand sting & end card (docs/10-scene-standar.md).
# Dibaca tools/bangun-timing.mjs DAN shared/StandarScenes.tsx lewat
# shared/config.gen.ts, supaya timing dan koreografi tidak bisa berbeda.
OPENING_SECONDS=4.0
CLOSING_LONG_SECONDS=5.0
CLOSING_SHORT_SECONDS=2.0


# --- Timing naskah & VO ------------------------------------------------------

# Padding napas setelah tiap baris VO: data-duration = durasi_vo + pad
VO_PAD_SECONDS=0.4

# Patokan kecepatan baca Bahasa Indonesia, untuk memperkirakan durasi dari
# rencana VO tiap scene (ideas/<slug>/scenes/<kunci>-vo.md — docs/11)
#
# 136 bukan tebakan: DIUKUR dari episode pertama. 434 kata VO menghasilkan 190,99 detik
# bicara sungguhan (202,09 total dikurangi opening 2,5 + closing 5,0 + padding
# 9x0,4). Angka 140 yang dipakai sebelumnya membuat tiap scene diperkirakan
# ~2,6% terlalu pendek, dan errornya menumpuk DI DALAM scene — di scene 80 kata,
# beat terakhir meleset hampir satu detik.
#
# Kalau voice_settings.speed suatu saat dipakai, angka ini WAJIB ikut berubah:
# keduanya knob yang sama diukur dari ujung berbeda, dan yang tidak sinkron
# tidak menghasilkan error, cuma animasi yang mendarat salah.
VO_WORDS_PER_MINUTE=136

# Durasi sementara untuk scene yang rencana VO-nya belum ditulis. Dipakai supaya
# episode tetap bisa di-scrub dengan timing yang masuk akal; angkanya TIDAK
# pernah masuk render final, karena `npm run sisa` melarang render selama masih
# ada scene tanpa rencana VO.
VO_PLACEHOLDER_SECONDS=4.0

# Volume musik latar, dipakai <Audio volume={...}> di komposisi
MUSIC_VOLUME=0.12

# Subtitel preview — teks VO ditampilkan di layar SELAMA berkas VO scene itu
# belum ada, supaya komposisi bisu tetap bisa dinilai timing-nya (docs/11).
# Pergantian ke suara terjadi sendiri per scene begitu public/vo/<slug>/L-<kunci>.mp3
# ada; ini cuma pemaksa saat memeriksa.
#   auto  subtitel hanya di scene yang belum punya VO   <- baku
#   off   jangan tampilkan sama sekali (lihat frame apa adanya)
#   on    tampilkan walau VO-nya sudah ada (cek sinkron VO vs teks)
SUBTITLE_MODE=auto


# --- Render (Remotion) -------------------------------------------------------
# Remotion membawa FFmpeg-nya sendiri dan mengunduh Chrome Headless Shell saat
# render pertama. Yang di bawah hanya untuk kasus khusus.

# Isi hanya kalau ffmpeg/ffprobe/Chrome tidak ada di PATH.
# FFPROBE_PATH dipakai tools/vo-durations.mjs, bukan oleh Remotion.
FFMPEG_PATH=
FFPROBE_PATH=
CHROME_PATH=


# --- Loudness & audio --------------------------------------------------------

TARGET_LUFS=-14
MUSIC_DUCK_LUFS=-28


# --- Path --------------------------------------------------------------------

TOPICS_DIR=topics
SHARED_DIR=shared


# --- YouTube (opsional, kalau nanti unggah otomatis) -------------------------
# Kosongkan selama unggah masih manual.

YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
