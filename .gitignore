# =============================================================================
# HANYA .env.example yang boleh masuk repo. Berkas .env berisi API key asli.
# Aturan lengkap: docs/08-konfigurasi.md
# =============================================================================

.env
.env.*
!.env.example

# Bentuk secret lain yang mungkin muncul kemudian
*.pem
*.key
*.p12
*.pfx
credentials*.json
client_secret*.json
*_secret*
.netrc

# --- Keluaran produksi (berat) ----------------------------------------------
# Thumbnail (thumb.png) dan render/publish.md SENGAJA tidak di-ignore —
# keduanya kecil dan merupakan bagian dari catatan episode.

*.mp4
*.mov
*.webm
*.mp3
*.wav
*.m4a

# --- Tooling -----------------------------------------------------------------
# graphify: keluaran knowledge graph, dibangun ulang dari sumber.
# Konsisten dengan getresolved/ dan apps/justmart/ yang juga meng-ignore-nya
# (di justmart ukurannya ~30 MB).
graphify-out/

# --- Berkas generate ---------------------------------------------------------
# Keduanya dibangun ulang oleh `npm run gen` dari sumber yang DI-commit
# (.env dan ideas/<slug>/naskah.md). Meng-commit-nya berarti dua sumber
# kebenaran yang bisa berbeda diam-diam.
#
# config.gen.ts turunan .env — di-ignore juga karena .env-nya rahasia; kalau
# ikut masuk repo, daftar putih di tools/bangun-config.mjs jadi satu-satunya
# yang menahan setelan produksi bocor ke publik.
shared/config.gen.ts
ideas/*/timing.gen.ts

node_modules/
out/
*.log
npm-debug.log*

# --- OS ----------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# Keluaran render uji di root
render/
