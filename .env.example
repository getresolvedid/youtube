# =============================================================================
# Konfigurasi channel — SATU sumber untuk semua secret & setelan produksi.
#
#   Salin berkas ini jadi .env, lalu isi nilainya:
#     Copy-Item .env.example .env
#
#   .env TIDAK PERNAH di-commit (lihat .gitignore). Berkas ini (.env.example)
#   yang di-commit — jadi setiap variabel baru WAJIB ditambahkan di sini juga,
#   dengan nilai kosong atau contoh, jangan nilai asli.
#
#   Cara memakai:
#     Node    : node --env-file=.env tools/skrip.mjs      (Node 22 native)
#     PowerShell: . .\tools\load-env.ps1                  (untuk sesi terminal)
#     Komposisi : lewat shared/config.gen.ts (npm run gen) — daftar putih saja
#
#   Dokumen: docs/08-konfigurasi.md
# =============================================================================


# --- Identitas channel -------------------------------------------------------
# Dipakai di end card, deskripsi video, dan metadata publish.

CHANNEL_NAME=
CHANNEL_HANDLE=
CHANNEL_URL=

# Tujuan CTA di akhir video. Kosongkan kalau belum diputuskan.
CTA_URL=https://getresolved.id
CTA_TEXT=


# --- ElevenLabs (voice over) -------------------------------------------------
# API key: https://elevenlabs.io/app/settings/api-keys — RAHASIA, jangan dibagikan.
#
# Key bisa dirotasi. Yang dipakai semua skrip SELALU ELEVENLABS_API_KEY;
# _2, _3, ... adalah cadangan (mis. akun lain, atau key pengganti saat rotasi
# keamanan). Kelola lewat tools/elevenlabs-keys.mjs:
#   node tools/elevenlabs-keys.mjs status | check | rotate [--auto] | add <key> | drop <n>

ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=

# Voice ID dikunci untuk seluruh channel. Ganti voice = ganti identitas channel.
# Channel ini memakai "George" (JBFqnCBsd6RMkjVDRZzb) — pria, hangat, gaya pencerita.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_NAME=George

# Pagar biaya. 1 karakter = 1 kredit di multilingual v2; satu topik (1 video
# panjang + 2 Shorts) diperkirakan ~9.000–12.000 karakter. Naskah WAJIB beku
# sebelum VO dibuat — lihat docs/04 §5.
ELEVENLABS_MAX_CHARS_PER_TOPIC=12000

# eleven_multilingual_v2 = default channel (stabil, konsisten antar-episode)
# eleven_v3              = lebih ekspresif, untuk Shorts berenergi tinggi
# eleven_flash_v2_5      = JANGAN untuk produksi final
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# mp3_44100_128 cukup untuk narasi. Pakai pcm_44100 kalau ada proses audio lanjutan.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Setelan suara. Stability terlalu tinggi = datar; terlalu rendah = tidak konsisten.
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEAKER_BOOST=true


# --- Spesifikasi video -------------------------------------------------------
# Angka ini mengikat guideline docs/02. Mengubahnya = mengubah format channel.

VIDEO_FPS=30

LONG_WIDTH=1920
LONG_HEIGHT=1080
LONG_TARGET_SECONDS=480          # 8 menit

SHORT_WIDTH=1080
SHORT_HEIGHT=1920
SHORT_MAX_SECONDS=60

# Durasi scene standar — brand sting & end card (docs/10-scene-standar.md).
# Dibaca tools/bangun-timing.mjs DAN shared/StandarScenes.tsx lewat
# shared/config.gen.ts, supaya timing dan koreografi tidak bisa berbeda.
OPENING_SECONDS=2.5
CLOSING_LONG_SECONDS=5.0
CLOSING_SHORT_SECONDS=2.0


# --- Timing naskah & VO ------------------------------------------------------

# Padding napas setelah tiap baris VO: data-duration = durasi_vo + pad
VO_PAD_SECONDS=0.4

# Patokan kecepatan baca Bahasa Indonesia, untuk memperkirakan durasi dari naskah
VO_WORDS_PER_MINUTE=140

# Volume musik latar, dipakai <Audio volume={...}> di komposisi
MUSIC_VOLUME=0.12


# --- Render (Remotion) -------------------------------------------------------
# Remotion membawa FFmpeg-nya sendiri dan mengunduh Chrome Headless Shell saat
# render pertama. Yang di bawah hanya untuk kasus khusus.

# Isi hanya kalau ffmpeg/ffprobe/Chrome tidak ada di PATH.
# FFPROBE_PATH dipakai tools/vo-durations.mjs, bukan oleh Remotion.
FFMPEG_PATH=
FFPROBE_PATH=
CHROME_PATH=


# --- Loudness & audio --------------------------------------------------------

TARGET_LUFS=-14
MUSIC_DUCK_LUFS=-28


# --- Path --------------------------------------------------------------------

TOPICS_DIR=topics
SHARED_DIR=shared


# --- YouTube (opsional, kalau nanti unggah otomatis) -------------------------
# Kosongkan selama unggah masih manual.

YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
